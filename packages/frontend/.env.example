# Odin Connect configuration. Copy to `.env` and adjust for your environment.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Plinko"

# Odin environment: prod | dev | local
VITE_ODIN_ENV=dev

# App canister principal — ICRC-2 spender for deposits. Once the app canister
# exists, dfx writes canister ids to the root `.env` on deploy; copy the id here.
VITE_APP_CANISTER_ID=sfgyi-iyaaa-aaaam-qepyq-cai
