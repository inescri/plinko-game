# Odin Connect configuration. Copy to `.env` and adjust for your environment.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Plinko"

# Odin environment: prod | staging | dev | local | legacy
# Any other value fails at startup with a clear error.
# Must match the Odin ledger the canister was deployed with (`getOdinLedger`):
#   dev → w5cxm-6iaaa-aaaaj-az4jq-cai (pnpm deploy:dev, dfx canister `canister_dev`)
#   prod / staging → yspgd-ciaaa-aaaaj-a6rrq-cai (pnpm deploy:prod, dfx canister `canister`)
VITE_ODIN_ENV=prod

# App canister principal — ICRC-2 spender for deposits and the actor target
# for play/withdraw. dfx writes canister ids to the root `.env` on deploy:
# CANISTER_ID_CANISTER (prod ledger) or CANISTER_ID_CANISTER_DEV (dev ledger).
# Copy the one matching VITE_ODIN_ENV here.
VITE_APP_CANISTER_ID=

# The one Odin token id players can deposit and bet with. The house must be
# funded in this token (`fundHouse`) or every bet is rejected.
VITE_GAME_TOKEN_ID=btc

# Odin principals that see the "Fund house" admin button, comma-separated.
# UI gate only: fundHouse is permissionless on the canister.
VITE_HOUSE_ADMINS=

# dfx network: local (default) uses a local replica + fetches the root key;
# ic targets mainnet.
VITE_DFX_NETWORK=local

# Replica/boundary host (optional). Defaults: local → http://127.0.0.1:4943,
# ic → https://icp-api.io
# VITE_IC_HOST=http://127.0.0.1:4943
